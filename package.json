{
    "name": "@zalkera/storefront-examples",
    "version": "0.1.0",
    "engines": {
        "node": ">=22"
    },
    "private": true,
    "description": "잘커라(Zalkera) 스토어프론트 예제 소스 — @zalkera/client 위에서 도는 Next.js 쇼핑몰/예약/기업소개 사이트의 완성품 골격. 받아서 고쳐 쓰는 출발점이자, llms.txt 레시피가 참이라는 증명.",
    "zalkera": {
        "styling": "tailwind-tokens",
        "content": "source"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "typecheck": "tsc --noEmit",
        "verify": "npm run validate && npm run typecheck && npm test",
        "validate": "node scripts/validate-storefront.mjs",
        "check:aeo": "node scripts/check-aeo-surfaces.mjs",
        "test": "node --experimental-strip-types --test \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
        "format": "prettier --write --cache .",
        "format:check": "prettier --check --cache ."
    },
    "dependencies": {
        "@tosspayments/tosspayments-sdk": "^2.7.1",
        "@zalkera/client": "^0.26.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.545.0",
        "next": "16.2.12",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "tailwind-merge": "^3.3.1"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "prettier": "^3.9.6",
        "tailwindcss": "^4",
        "typescript": "^5"
    },
    "overrides": {
        "postcss": "^8.5.25",
        "sharp": "^0.35.3",
        "nanoid": "^3.3.18"
    }
}
