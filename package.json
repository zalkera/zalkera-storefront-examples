{
    "name": "@zalkera/storefront-template",
    "version": "0.1.0",
    "private": true,
    "description": "잘커라(Zalkera) 스토어프론트 스타터 — @zalkera/client 위에서 도는 Next.js 쇼핑몰/예약 사이트 골격. AI 바이브코딩의 출발점.",
    "zalkera": {
        "styling": "tailwind-tokens",
        "content": "source"
    },
    "scripts": {
