{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
        // 테스트가 `./crossOrigin.ts` 처럼 확장자를 붙여 import 한다 — Node 기본 러너의
        // 타입 스트리핑(`--experimental-strip-types`)이 확장자를 **요구**하기 때문이다.
        // `noEmit` 이라 방출 경로가 없으므로 이 완화가 빌드 산출물에 영향을 주지 않는다.
        "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    // 팩 입력이지 이 프로젝트가 아니다(팩 v4 — `presets/<code>/src/` 는 그 팩의 소스 전량).
    // 여기 넣어 두면 루트 타입체크가 팩 소스를 자기 것으로 알고 `content/index.ts`(팩이 생성)를
    // 못 찾아 죽는다. 팩 소스의 타입·빌드는 zip 을 실제로 세우는 `scripts/verify-zip.mjs` 가 본다.
    // 고객 zip 에는 `presets/` 가 없어 이 줄이 아무 일도 하지 않는다.
    "presets"
  ]
}
