# 잘커라 백엔드 베이스 URL (뒤에 /api 붙이지 않는다). 예: http://localhost:8100
ZALKERA_API_BASE=http://localhost:8100

# 이 사이트의 공개 절대 URL. sitemap.xml·robots.txt·JSON-LD 가 절대 URL 을 요구한다(크롤러가
# 상대경로를 정규화하지 못한다). **배포 전 반드시 실제 도메인으로 바꿀 것** — 안 그러면
# 검색엔진에 localhost 가 색인된다. 끝 슬래시는 있어도 되고 없어도 된다.
ZALKERA_SITE_URL=http://localhost:3000
# 이 사이트의 테넌트 코드. 모든 요청에 X-Tenant 로 실린다.
# **반드시 자기 테넌트 코드로 바꿀 것** — 코드에 폴백이 없어서 비우면 기동/빌드가 실패한다(의도).
ZALKERA_TENANT=your-tenant-code

# 스토어프론트 서버 시크릿 키(oqsk_…). 있으면 모든 백엔드 호출에 X-Storefront-Key 로 실려
# 이 사이트를 인증한다. **서버 전용** — NEXT_PUBLIC_ 접두사 절대 금지(브라우저 번들에 시크릿 유출).
# 관리형(잘커라 오케스트레이터 서빙)은 기동 시 자동 주입되므로 여기 비워 둔다.
# BYO(자체 배포)는 콘솔에서 발급해 이 값에 넣는다. 부재는 정상(dual 이행기 — 키 없으면 헤더 미전송).
ZALKERA_STOREFRONT_KEY=

# 소셜 로그인 public client_id — 브라우저에 노출되는 값이라 NEXT_PUBLIC_ 접두사를 쓴다.
# client_secret 은 절대 여기 두지 않는다(백엔드 tenant_oauth_app 이 보관·교환). 미설정 provider 버튼은 안내 후 무동작.
NEXT_PUBLIC_KAKAO_CLIENT_ID=
NEXT_PUBLIC_NAVER_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Analytics 4 측정 ID(G-XXXXXXXX). **발주처가 준 값만** 넣는다 — 없으면 비워 두고, 비어 있으면 태그가 안 실린다.
# 브라우저에 노출되는 값이라 NEXT_PUBLIC_ 이고 빌드타임에 인라인된다. 관리형(Next 소스 업로드)은 콘솔 「사이트 환경변수」에
# 넣으면 재빌드로 반영된다(수 분 소요). BYO 는 여기 넣는다. 형식이 G-… 가 아니면 무시한다(잘못된 ID 로 남의 속성에 쏘지 않는다).
NEXT_PUBLIC_GA4_ID=

# 온디맨드 revalidate 공유 시크릿. 백엔드가 데이터 변경 시
# POST /api/revalidate 를 `x-oneque-revalidate-secret` 헤더로 호출해 ISR 캐시를 무효화한다.
# 미설정이면 그 엔드포인트는 비활성(503). 강한 랜덤값을 넣고 백엔드와 공유한다.
ZALKERA_REVALIDATE_SECRET=

# 미리보기 모드 플래그 — 미리보기 러너가 `next dev` 프로세스에 =1 로 주입한다.
# =1 이면 프로덕션 공개 API(읽기)만 소비하고 쓰기(체크아웃·장바구니 변경)를 차단해야 한다(프로덕션 데이터 오염 방지).
# 평상시(직접 배포)에는 비워 둔다. src/lib/preview.ts 의 isPreview() 로 판별한다.
NEXT_PUBLIC_ZALKERA_PREVIEW=

# 백엔드 없이 빌드가 돌아야 하는 자리(게이트 CI)에서 =1 로 둔다. CI 배선과 검수 도구가 그렇게 켠다.
#
# ⚠ **지금 이 플래그는 아무것도 바꾸지 않는다.** 읽는 코드(`src/lib/buildEnv.ts` 의 `isOfflineBuild`)에
# 호출자가 없다 — 유일한 호출자였던 홈의 폴백이 콘텐츠를 소스로 옮기면서 사라졌고, 남은 백엔드 호출은
# 전부 fail-soft 라 애초에 빌드를 세우지 않는다. **켜든 안 켜든 백엔드가 죽어도 빌드는 통과한다**(실측).
# 그러니 "안 켜면 장애 때 빌드가 막아 준다"고 믿지 마라 — 막지 않는다. 그 감지를 무엇으로 할지는
# 아직 열린 물음이고, 자세한 사정은 위 파일 주석에 적혀 있다.
ZALKERA_OFFLINE_BUILD=

# 신뢰하는 프록시 홉 수. `visitorIp()` 가 `x-forwarded-for` 를 **뒤에서부터** 몇 번째로 읽을지 정한다.
#
# ⚠ **이 값이 배포와 안 맞으면 위조가 그대로 통과한다.** 기본값은 1(맨 뒤 항목)인데, 그 항목은
#   **바로 앞 홉이 붙인 것**이다. 프록시가 없으면 XFF 전체가 방문자가 쓴 문자열이라 맨 뒤도 위조값이고,
#   IP 축 레이트리밋(문의 3/분 · 리드 30/60초 · 게스트 주문조회)이 헤더 한 줄로 무력해진다.
#   반대로 프록시가 2단인데 1로 두면 프록시 IP 를 방문자로 읽어 **전 방문자가 같은 칸**을 쓴다(전원 429).
#
#   0     프록시 없음 — IP 를 **아예 주장하지 않는다**(fail-closed). 레이트리밋은 테넌트 단위가 된다.
#   1     프록시 1단(기본값)
#   2 이상 CDN + 로드밸런서처럼 앞에 여러 단이 있을 때, 그 단 수만큼
#
#   자기 인프라로 돌리는 BYO 사이트는 **직접 세어서** 넣어야 한다. 모르면 0 이 안전하다.
ZALKERA_TRUSTED_PROXY_HOPS=
